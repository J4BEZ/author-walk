{
  "name": "author-walk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "server:watch": "node --watch --env-file-if-exists=.env server/index.js",
    "server-with-delay": "node --env-file-if-exists=.env server/index.js --delay 1000",
    "set-role": "node server/scripts/setRole.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "express": "^4.22.3",
    "globals": "^17.13.0",
    "jose": "^6.2.18",
    "json-server": "^0.17.4",
    "vite": "^8.3.6"
  }
}
